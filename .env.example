# Neon Postgres (pooled connection string)
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin account created by `pnpm db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (signed uploads from admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, defaults to "praew-tattoos"
CLOUDINARY_UPLOAD_FOLDER=

# Instagram API with Facebook Login — long-lived EAA… token (overrides a token pasted in Admin)
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional, defaults to "v26.0"
META_GRAPH_API_VERSION=

# Shared secret for Vercel Cron (sent as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=
