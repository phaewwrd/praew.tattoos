# Neon Postgres (pooled connection string)
DATABASE_URL=

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Admin account created by `pnpm db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (signed uploads from admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instagram API with Instagram Login — long-lived token (copied to DB on first use)
INSTAGRAM_ACCESS_TOKEN=

# Shared secret for Vercel Cron (sent as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=
